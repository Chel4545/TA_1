%{
#include <iostream>
%}

%class SmcClass
%fsmclass ContextFSM
%fsmfile ContextFSM

%start ExampleMap::Start

//состояния
%map ExampleMap
%%

Start
{
    process(token: const Token&) [ctxt.IsCreate(token)]
    GotCreate
    {
        resetLine();
    }

    process(token: const Token&) [ctxt.IsEol(token)]
    nil
    {}

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

GotCreate
{
    process(token: const Token&) [ctxt.IsId(token)]
    GotName
    {
        setName0(token.text);
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

GotName
{
    process(token: const Token&) [ctxt.IsLParen(token)]
    InList
    {
        setCreateList();
    }

    process(token: const Token&) [ctxt.IsAs(token)]
    GotAs
    {
        setCreateJoin();
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

InList
{
    process(token: const Token&) [ctxt.IsId(token)]
    AfterId
    {
        setAttribute(token.text);
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

AfterId
{
    process(token: const Token&) [ctxt.IsComma(token)]
    InList
    {}

    process(token: const Token&) [ctxt.IsRParen(token)]
    End
    {
        markCreateList();/.тут выполнение команды
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

GotAs
{
    process(token: const Token&) [ctxt.IsId(token)]
    GotNameAs
    {
        setName1(token.text);
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

GotNameAs
{
    process(token: const Token&) [ctxt.IsJoin(token)]
    GotJoin
    {}

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

GotJoin
{
    process(token: const Token&) [ctxt.IsId(token)]
    End
    {
        setName2(token.text);
        markCreateJoin();
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

End
{
    process(token: const Token&) [ctxt.IsEol(token)]
    Accept
    {
        executeCommand();
        resetLine();
    }

    process(token: const Token&)
    Error
    {
        syntaxError();
        resetLine();
    }
}

Accept
{
    process(token: const Token&) [ctxt.IsEol(token)]
    nil
    {}

    process(token: const Token&)
    Error
    {}
}

Error
{
    process(token: const Token&) [ctxt.IsEol(token)]
    Start
    {}

    process(token: const Token&)
    nil
    {}
}

%%