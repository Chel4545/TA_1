%{
#include <iostream>

%}

%class SmcClass
%fsmclass ContextFSM
%fsmfile ContextFSM

%start ExampleMap::Start

//состояния
%map ExampleMap
%%

Start
{
    CREATE
        GotCreate
        {}

    Default
        Error
        {}
}

GotCreate
{
    ID(name: std::string) //хуйня, передавать по одной букве
        GotName
        {
            setName0(name); //наш пользовательский код
        }

    Default
        Error
        {}
}

GotName
{
    SymbolLparent //[ctxt.pos < module.size] - крч на языке проги тут пишем и возвращаем bool, условие перехода в состояние
        InList
        {}

//    можно назвать одинаково, главное разные условия в [] прописать
//    SymbolLparent
//        InList
//        {}
//

    CommandAs
        GotAs
        {}

    Default
        Error
        {}
}

InList
{
    ID(attribute: std::string)
        AfterId
        {
            setAttribute(attribute);
        }

    Default
        Error
        {}
}

AfterId
{
    SymbolComma
        InList
        {}

    SymbolRparent
        End
        {
            setCreateList();
        }

    Default
        Error
        {}
}

//2команда

GotAs
{
    ID(name: std::string)
        GotNameAs
        {
            setName1(name);
        }

    Default
        Error
        {}
}

GotNameAs
{
    CommandJoin
        GotJoin
        {}

    Default
        Error
        {}
}

GotJoin
{
    ID(name: std::string)
        End
        {
            setName2(name);
            setCreateJoin();
        }

    Default
        Error
        {}

}

End
{
    EOL
        Accept
        {
            executeCommand();
            resetLine();
        }

    Default
        Error
        {
            syntaxError();
            resetLine();
        }
}

Accept
{
    Default
        nil //переход в самого себя
        {}
}

Error
{
    Default
        nil
        {}
}

/* Global transitions */
Default //можно убрать Default во всех остальных и он автоматически подставиться
{
    Default
        Error
        {
            syntaxError();
            resetLine();
        }
}

%%